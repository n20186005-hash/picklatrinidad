---
import '../styles/global.css';

const place = {
  name: 'Strawberry Farm - Home of Giant Strawberry Cake',
  shortName: 'Strawberry Farm',
  address: 'Swamp Area, ID-58, Strawberry Valley Hotel, Strawberry Farm Rd, La Trinidad, 2601 Benguet, Philippines',
  latitude: 16.4580848,
  longitude: 120.5877882,
  rating: 4.3,
  ratingCount: 4093,
  opens: '06:00',
  closes: '18:00'
};

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImageUrl = Astro.site ? new URL('/images/field-valley.webp', Astro.site).toString() : undefined;

const faqs = [
  {
    question: 'When is the best time to pick strawberries?',
    answer: 'Cool, dry-season mornings are the easiest time to visit. February to April is often a strong picking window, but harvest volume depends on weather, field rotation and the day’s crop. Arrive early and ask growers what is available before paying for a picking basket.'
  },
  {
    question: 'Is there an entrance fee?',
    answer: 'Walking around the wider farm and market area is commonly free. Small local, environmental or activity fees may be collected at some access points, and strawberry picking is charged separately by weight. Confirm the day’s arrangement onsite.'
  },
  {
    question: 'How much does strawberry picking cost?',
    answer: 'Picking is priced by weight and can change by grower, season and supply. Recent visitor reports commonly mention roughly ₱500–₱700 per kilogram as an indicative range, but it should not be treated as a fixed official rate.'
  },
  {
    question: 'How long should I spend at the farm?',
    answer: 'Allow about 1.5–2.5 hours if you want to pick, browse the pasalubong stalls, snack and take photos. A quick market-and-photo stop can fit into roughly an hour.'
  },
  {
    question: 'Can I visit without picking strawberries?',
    answer: 'Yes. You can still walk the farm area, shop for fresh berries and local products, try strawberry snacks and enjoy the Cordillera valley scenery without joining a pick-your-own activity.'
  },
  {
    question: 'Is parking available?',
    answer: 'Parking is available around the farm area, but spaces can fill quickly on weekends, holidays and peak strawberry-season mornings. Paid parking may apply depending on the lot, so bring small cash and arrive early if driving.'
  }
];

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: place.name,
  description: 'Independent visitor guide to La Trinidad Strawberry Farm in Benguet, known for strawberry picking, fresh produce, local pasalubong and the Giant Strawberry Cake tradition.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Strawberry Farm Rd, Barangay Betag',
    addressLocality: 'La Trinidad',
    addressRegion: 'Benguet',
    postalCode: '2601',
    addressCountry: 'PH'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: place.latitude,
    longitude: place.longitude
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: place.opens,
      closes: place.closes
    }
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: place.rating,
    ratingCount: place.ratingCount,
    bestRating: 5
  },
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  ...(socialImageUrl ? { image: [socialImageUrl] } : {})
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};

const saveableStops = [
  { id: 'farm-picking', name: 'Pick strawberries', meta: 'Strawberry Farm · Betag' },
  { id: 'farm-market', name: 'Browse the pasalubong market', meta: 'Strawberry Farm · Betag' },
  { id: 'red-berry-cafe', name: 'Red Berry Cafe', meta: 'Near the Orchidarium' },
  { id: 'kabunian-cafe', name: 'Kabunian Cafe & Restaurant', meta: 'Strawberry Farm Road' },
  { id: 'mt-kalugong', name: 'Mt. Kalugong Cultural Village', meta: 'La Trinidad side trip' },
  { id: 'mt-yangbew', name: 'Mt. Yangbew', meta: 'Short ridge hike' },
  { id: 'mount-costa', name: 'Mount Costa', meta: 'Garden side trip' }
];
---
<!doctype html>
<html lang="en-PH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fffaf0" />
    <meta name="description" content="Plan a visit to Strawberry Farm in La Trinidad, Benguet: strawberry picking, costs, parking, transport, food, nearby sights, photo gallery and a private on-device itinerary." />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:title" content="Strawberry Farm La Trinidad — Visitor Guide" />
    <meta property="og:description" content="A field-side guide to strawberry picking, local food, transport and the best stops around La Trinidad's Strawberry Farm." />
    <meta property="og:image" content={socialImageUrl ?? '/images/field-valley.webp'} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Strawberry Farm La Trinidad — Visitor Guide" />
    <meta name="twitter:description" content="A practical, independent guide to La Trinidad Strawberry Farm in Benguet." />
    <meta name="twitter:image" content={socialImageUrl ?? '/images/field-valley.webp'} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>Strawberry Farm La Trinidad — Picking, Food & Visitor Guide</title>
    <script type="application/ld+json" set:html={JSON.stringify(placeSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body class="paper-grain antialiased">
    <a href="#main" class="sr-only focus:not-sr-only fixed left-4 top-4 z-[100] rounded-full bg-ink px-4 py-2 text-sm font-bold text-white">Skip to content</a>

    <header class="relative z-50 border-b border-soil-700/15 bg-cream/92 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3 lg:px-8">
        <a href="#top" class="shrink-0" aria-label="Strawberry Farm visitor guide home">
          <img src="/logo.svg" width="270" height="64" alt="Strawberry Farm La Trinidad" class="h-14 w-auto" />
        </a>
        <nav aria-label="Primary" class="hidden items-center gap-1 text-sm font-semibold text-soil-700 lg:flex">
          <a href="#visit" class="rounded-full px-3 py-2 hover:bg-leaf-100">Plan visit</a>
          <a href="#getting-there" class="rounded-full px-3 py-2 hover:bg-leaf-100">Getting there</a>
          <a href="#nearby" class="rounded-full px-3 py-2 hover:bg-leaf-100">Nearby</a>
          <a href="#gallery" class="rounded-full px-3 py-2 hover:bg-leaf-100">Photos</a>
          <a href="#faq" class="rounded-full px-3 py-2 hover:bg-leaf-100">FAQ</a>
        </nav>
        <button type="button" data-itinerary-open class="flex items-center gap-2 rounded-full border border-leaf-700/20 bg-leaf-700 px-4 py-2.5 text-sm font-bold text-cream shadow-sm hover:bg-leaf-600" aria-controls="itinerary-panel">
          <span aria-hidden="true">✓</span>
          Day list <span data-itinerary-count class="rounded-full bg-cream/15 px-2 py-0.5 text-xs">0</span>
        </button>
      </div>
    </header>

    <main id="main">
      <section id="top" class="mountain-rule relative overflow-hidden bg-leaf-700 text-cream">
        <div class="absolute inset-0 opacity-35" aria-hidden="true" style="background:radial-gradient(circle at 18% 20%, #d7433b 0 2px, transparent 3px) 0 0/28px 28px"></div>
        <div class="relative mx-auto grid min-h-[760px] max-w-7xl items-center gap-10 px-5 pb-24 pt-12 lg:grid-cols-[0.88fr_1.12fr] lg:px-8 lg:pt-16">
          <div class="relative z-10 py-8 lg:py-16">
            <div class="mb-5 inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/8 px-4 py-2 text-sm font-semibold tracking-wide">
              <span class="berry-dot scale-75" aria-hidden="true"></span>
              La Trinidad · Benguet · Philippines
            </div>
            <p class="mb-3 text-xs font-black uppercase tracking-[0.28em] text-berry-200">A valley you can taste</p>
            <h1 class="max-w-2xl font-display text-5xl font-bold leading-[0.98] tracking-[-0.035em] sm:text-6xl lg:text-7xl">
              Pick the morning.<br /><span class="text-berry-200">Take home the berries.</span>
            </h1>
            <p class="mt-7 max-w-xl text-lg leading-8 text-cream/80">
              Strawberry rows, cool Cordillera air, warm taho and a market full of red. This independent field guide helps you make a simple La Trinidad farm morning feel unhurried.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#visit" class="rounded-full bg-berry-500 px-6 py-3.5 font-bold text-white shadow-lg shadow-black/15 hover:bg-berry-600">Plan your farm morning</a>
              <a href="#gallery" class="rounded-full border border-cream/25 bg-cream/8 px-6 py-3.5 font-bold text-cream hover:bg-cream/15">See real photos</a>
            </div>
            <dl class="mt-10 grid max-w-xl grid-cols-3 gap-3 border-t border-white/15 pt-6">
              <div><dt class="text-xs uppercase tracking-wider text-cream/55">Google rating</dt><dd class="mt-1 font-display text-2xl font-bold">4.3 ★</dd></div>
              <div><dt class="text-xs uppercase tracking-wider text-cream/55">Listed hours</dt><dd class="mt-1 font-display text-2xl font-bold">6–6</dd></div>
              <div><dt class="text-xs uppercase tracking-wider text-cream/55">Good stay</dt><dd class="mt-1 font-display text-2xl font-bold">1.5–2.5h</dd></div>
            </dl>
          </div>

          <div class="relative min-h-[490px] lg:min-h-[610px]">
            <figure class="absolute inset-x-8 top-3 overflow-hidden rounded-[2.6rem] border-[10px] border-cream shadow-2xl shadow-black/30 sm:inset-x-16 lg:inset-x-4 lg:left-16 lg:right-0">
              <img src="/images/field-valley.webp" width="1800" height="1350" alt="Strawberry fields and mountain slopes in La Trinidad" class="h-[430px] w-full object-cover sm:h-[500px] lg:h-[560px]" fetchpriority="high" />
            </figure>
            <div class="absolute bottom-4 left-0 rotate-[-4deg] rounded-2xl bg-cream px-5 py-4 text-ink shadow-xl sm:left-8 lg:left-0">
              <p class="text-xs font-black uppercase tracking-[0.2em] text-berry-600">Field note</p>
              <p class="mt-1 font-display text-xl font-bold">Go early. Pick gently.</p>
              <p class="mt-1 max-w-[240px] text-sm leading-5 text-soil-700">Cooler air, softer light, and a better chance to find active picking rows.</p>
            </div>
            <div class="absolute right-0 top-0 rounded-full border-4 border-cream bg-berry-500 px-5 py-5 text-center text-sm font-black leading-4 text-white shadow-lg sm:right-6 lg:-right-5">
              HOME OF<br /><span class="font-display text-lg">GIANT</span><br />STRAWBERRY<br />CAKE
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24" aria-labelledby="story-heading">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.28em] text-berry-600">Why this place feels different</p>
            <h2 id="story-heading" class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl">Not a theme park.<br />A working valley.</h2>
            <p class="mt-6 text-lg leading-8 text-soil-700">The Strawberry Farm sits in Betag, La Trinidad, where agriculture and tourism overlap. Visitors come for pick-your-own rows, but the farm’s character is just as much in the roadside stalls: berries, preserves, vegetables, woven goods and strawberry-flavoured pasalubong.</p>
            <p class="mt-4 leading-7 text-soil-700">The “Giant Strawberry Cake” name points to La Trinidad’s celebrated strawberry-cake tradition. Treat it as part of the town’s identity rather than expecting a giant cake to be on permanent display every day.</p>
          </div>
          <div class="grid grid-cols-2 gap-4 sm:gap-5">
            <figure class="overflow-hidden rounded-[2rem] shadow-[var(--shadow-soft)]"><img src="/images/strawberry-picking.webp" width="1800" height="1200" alt="Visitors picking strawberries from farm rows" class="h-full min-h-[380px] w-full object-cover" loading="lazy" /></figure>
            <div class="grid gap-4 sm:gap-5">
              <figure class="overflow-hidden rounded-[2rem] shadow-[var(--shadow-soft)]"><img src="/images/strawberry-landmark.webp" width="1054" height="1400" alt="Giant strawberry landmark in La Trinidad" class="h-52 w-full object-cover sm:h-64" loading="lazy" /></figure>
              <div class="rounded-[2rem] bg-berry-500 p-6 text-white shadow-[var(--shadow-soft)] sm:p-8">
                <p class="font-display text-3xl font-bold">Strawberry & Rose Capital</p>
                <p class="mt-3 leading-6 text-white/80">La Trinidad’s farm identity makes this stop feel rooted in the valley, not staged around a single photo spot.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="visit" class="border-y border-soil-700/10 bg-white/45 py-16 lg:py-24">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="max-w-3xl">
            <p class="text-xs font-black uppercase tracking-[0.28em] text-berry-600">Plan the visit</p>
            <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">A practical field card for the day</h2>
            <p class="mt-4 text-lg leading-8 text-soil-700">Rates and crop availability change, so the most useful plan is to know what is stable—and what to confirm when you arrive.</p>
          </div>

          <div class="mt-10 grid gap-5 lg:grid-cols-12">
            <article class="field-card rounded-[2rem] p-7 lg:col-span-5">
              <div class="flex items-start justify-between gap-5">
                <div><p class="text-xs font-black uppercase tracking-[0.2em] text-leaf-600">Opening & timing</p><h3 class="mt-2 font-display text-3xl font-bold">Start with the cool air.</h3></div>
                <span class="rounded-full bg-leaf-100 px-3 py-1 text-sm font-bold text-leaf-700">Daily listing</span>
              </div>
              <dl class="mt-7 divide-y divide-soil-700/10">
                <div class="flex justify-between gap-4 py-4"><dt class="text-soil-700">Listed opening hours</dt><dd class="font-bold">6:00 AM–6:00 PM</dd></div>
                <div class="flex justify-between gap-4 py-4"><dt class="text-soil-700">Best arrival</dt><dd class="text-right font-bold">Early morning</dd></div>
                <div class="flex justify-between gap-4 py-4"><dt class="text-soil-700">Strong picking window</dt><dd class="text-right font-bold">Often Feb–Apr*</dd></div>
                <div class="flex justify-between gap-4 py-4"><dt class="text-soil-700">Suggested stay</dt><dd class="font-bold">1.5–2.5 hours</dd></div>
              </dl>
              <p class="mt-4 text-sm leading-6 text-soil-700">*Harvest is weather- and crop-dependent. A good season does not guarantee every row is open for picking on a particular day.</p>
            </article>

            <article class="ticket-edge rounded-[2rem] bg-berry-500 p-7 text-white shadow-[var(--shadow-lift)] lg:col-span-4">
              <p class="text-xs font-black uppercase tracking-[0.2em] text-berry-100">Tickets / costs</p>
              <h3 class="mt-2 font-display text-3xl font-bold">Pay for what you pick.</h3>
              <div class="mt-7 space-y-5">
                <div class="border-b border-white/20 pb-5"><p class="text-sm text-white/70">Wider farm / market area</p><p class="mt-1 text-2xl font-black">Commonly free to enter</p></div>
                <div class="border-b border-white/20 pb-5"><p class="text-sm text-white/70">Pick-your-own strawberries</p><p class="mt-1 text-2xl font-black">Priced by weight</p><p class="mt-1 text-sm text-white/75">Recent visitor reports often mention ~₱500–₱700/kg as an indicative range, not a fixed official price.</p></div>
                <div><p class="text-sm text-white/70">Small local / activity fees</p><p class="mt-1 font-bold">May apply at some access points</p></div>
              </div>
              <p class="mt-6 rounded-2xl bg-black/10 p-4 text-sm leading-6">Bring small cash. Ask the grower for the day’s price before you start picking.</p>
            </article>

            <article class="field-card rounded-[2rem] p-7 lg:col-span-3">
              <p class="text-xs font-black uppercase tracking-[0.2em] text-leaf-600">Parking</p>
              <h3 class="mt-2 font-display text-3xl font-bold">Early wheels win.</h3>
              <p class="mt-5 leading-7 text-soil-700">Parking is available around the farm area, but the easiest slots disappear first on weekends, holidays and busy picking mornings.</p>
              <ul class="mt-6 space-y-3 text-sm leading-6 text-soil-700">
                <li class="flex gap-3"><span aria-hidden="true">●</span><span>Paid parking may apply depending on the lot.</span></li>
                <li class="flex gap-3"><span aria-hidden="true">●</span><span>Keep small cash ready.</span></li>
                <li class="flex gap-3"><span aria-hidden="true">●</span><span>Avoid blocking farm access roads while waiting.</span></li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section id="getting-there" class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-[0.86fr_1.14fr]">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.28em] text-berry-600">Detailed transport</p>
            <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">From Baguio, follow the valley north.</h2>
            <p class="mt-5 text-lg leading-8 text-soil-700">The farm is close enough for a Baguio half-day, but traffic on the Baguio–La Trinidad corridor can change the feel of the trip. Build in breathing room.</p>

            <div class="mt-8 space-y-4">
              <article class="rounded-[1.6rem] border border-soil-700/15 bg-cream p-6">
                <div class="flex items-center gap-4"><span class="grid h-11 w-11 place-items-center rounded-full bg-leaf-700 font-black text-cream">01</span><div><p class="text-xs font-black uppercase tracking-wider text-leaf-600">Easiest</p><h3 class="font-display text-2xl font-bold">Taxi / Grab</h3></div></div>
                <p class="mt-4 leading-7 text-soil-700">From central Baguio, set the destination to Strawberry Farm, Betag, La Trinidad. A typical run can be around 20–30 minutes when traffic is moving, but peak traffic can make it longer. Ask to be dropped by the farm entrance / Strawberry Farm Road.</p>
              </article>
              <article class="rounded-[1.6rem] border border-soil-700/15 bg-cream p-6">
                <div class="flex items-center gap-4"><span class="grid h-11 w-11 place-items-center rounded-full bg-berry-500 font-black text-white">02</span><div><p class="text-xs font-black uppercase tracking-wider text-berry-600">Budget</p><h3 class="font-display text-2xl font-bold">La Trinidad jeepney</h3></div></div>
                <p class="mt-4 leading-7 text-soil-700">Look for La Trinidad-bound jeepneys around the Magsaysay / Baguio Center Mall area. Tell the driver you are going to Strawberry Farm in Betag so you do not end up on a route that turns away earlier. From the drop-off, expect a short walk into the farm area.</p>
              </article>
              <article class="rounded-[1.6rem] border border-soil-700/15 bg-cream p-6">
                <div class="flex items-center gap-4"><span class="grid h-11 w-11 place-items-center rounded-full bg-soil-700 font-black text-cream">03</span><div><p class="text-xs font-black uppercase tracking-wider text-soil-700">Flexible</p><h3 class="font-display text-2xl font-bold">Private car</h3></div></div>
                <p class="mt-4 leading-7 text-soil-700">Follow the Baguio–La Trinidad–Bontoc Road, then the local approach into Strawberry Farm Road. Use the map pin below for the final turn. Arrive early if you want easier parking and a calmer walk between the stalls.</p>
              </article>
              <article class="rounded-[1.6rem] border border-soil-700/15 bg-cream p-6">
                <div class="flex items-center gap-4"><span class="grid h-11 w-11 place-items-center rounded-full bg-amber-600 font-black text-white">04</span><div><p class="text-xs font-black uppercase tracking-wider text-amber-600">From the Airport</p><h3 class="font-display text-2xl font-bold">Bus + local ride</h3></div></div>
                <p class="mt-4 leading-7 text-soil-700">Fly into Clark International Airport (CRX) — about 2.5 hours by bus to Baguio via Dau terminal — or Ninoy Aquino International Airport in Manila (MNL), roughly 5–6 hours by deluxe bus to Baguio. From the Baguio bus terminal, take a taxi or La Trinidad jeepney the final 20–30 minutes to the farm. If arriving via Loakan Airport (Baguio), it is a short 15-minute taxi ride to Betag.</p>
              </article>
            </div>
          </div>

          <div class="lg:sticky lg:top-24 lg:self-start">
            <div class="overflow-hidden rounded-[2.2rem] border-[6px] border-white bg-white shadow-[var(--shadow-lift)]">
              <iframe
                title="Map of Strawberry Farm in La Trinidad, Benguet"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6815.676140498642!2d120.58778819999998!3d16.458084799999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3391a3a5051f230b%3A0x4839af09b264e83e!2sStrawberry%20Farm%20-%20Home%20of%20Giant%20Strawberry%20Cake!5e1!3m2!1szh-CN!2s!4v1786376194507!5m2!1szh-CN!2s"
                width="100%"
                height="450"
                style="border:0"
                loading="lazy"
                allowfullscreen=""
                referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 px-2 text-sm text-soil-700">
              <span>16.4580848, 120.5877882 · Barangay Betag</span>
              <a href="https://maps.app.goo.gl/Kof8tjQ4s5DdZfnL7" rel="noopener noreferrer" class="font-bold text-berry-600 underline decoration-berry-200 underline-offset-4">Open supplied map →</a>
            </div>
          </div>
        </div>
      </section>

      <section class="overflow-hidden bg-leaf-700 py-16 text-cream lg:py-24" aria-labelledby="taste-heading">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
            <figure class="relative">
              <img src="/images/strawberry-landmark.webp" width="1054" height="1400" alt="Giant strawberry landmark celebrating La Trinidad’s berry identity" class="h-[480px] w-full rounded-[2.5rem] border-8 border-cream object-cover shadow-2xl shadow-black/20" loading="lazy" />
              <figcaption class="absolute -bottom-5 right-5 rotate-2 rounded-xl bg-berry-500 px-4 py-3 font-display text-lg font-bold text-white shadow-lg">Bring a little red home.</figcaption>
            </figure>
            <div>
