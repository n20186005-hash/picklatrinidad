      <div class="flex items-center justify-between border-b border-soil-700/15 p-5">
        <div><p class="text-xs font-black uppercase tracking-[0.2em] text-berry-600">On this device only</p><h2 class="mt-1 font-display text-3xl font-bold">My farm day</h2></div>
