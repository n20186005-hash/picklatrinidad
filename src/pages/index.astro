        <div id="itinerary-empty" class="mt-8 rounded-[1.5rem] border border-dashed border-soil-700/25 p-8 text-center"><p class="font-display text-2xl font-bold">Nothing saved yet.</p><p class="mt-2 text-sm leading-6 text-soil-700">Use the “Save” buttons around the guide to build a compact La Trinidad day.</p></div>
      </div>
      <div class="border-t border-soil-700/15 p-5"><button id="itinerary-clear" type="button" class="w-full rounded-full border border-berry-700/20 bg-white px-5 py-3 font-bold text-berry-700">Clear my list</button></div>
    </aside>

    <script id="saveable-stops-data" type="application/json" set:html={JSON.stringify(saveableStops)}></script>
    <script>
      type SavedStop = { id: string; name: string; meta: string };

      const STORAGE_KEY = 'la-trinidad-strawberry-farm-day-list-v1';
      const stopsData = document.querySelector<HTMLScriptElement>('#saveable-stops-data')?.textContent ?? '[]';
      const allStops = JSON.parse(stopsData) as SavedStop[];
      const panel = document.querySelector<HTMLElement>('#itinerary-panel');
      const backdrop = document.querySelector<HTMLElement>('#itinerary-backdrop');
      const itemsRoot = document.querySelector<HTMLElement>('#itinerary-items');
      const emptyState = document.querySelector<HTMLElement>('#itinerary-empty');
      const countLabels = document.querySelectorAll<HTMLElement>('[data-itinerary-count]');
      const saveButtons = document.querySelectorAll<HTMLButtonElement>('[data-save-item]');

      const readSaved = (): string[] => {
        try {
          const value = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          return Array.isArray(value) ? value.filter((id): id is string => typeof id === 'string') : [];
        } catch {
          return [];
        }
      };

      const writeSaved = (ids: string[]) => localStorage.setItem(STORAGE_KEY, JSON.stringify(ids));

      const updateButtons = (ids: string[]) => {
        saveButtons.forEach((button) => {
          const id = button.dataset.id;
          const saved = id ? ids.includes(id) : false;
          button.dataset.saved = String(saved);
          if (saved) button.setAttribute('aria-pressed', 'true');
          else button.setAttribute('aria-pressed', 'false');
        });
      };

      const render = () => {
        const ids = readSaved();
        countLabels.forEach((node) => node.textContent = String(ids.length));
        updateButtons(ids);
        if (!itemsRoot || !emptyState) return;
        itemsRoot.replaceChildren();
        emptyState.classList.toggle('hidden', ids.length > 0);
        ids.forEach((id, index) => {
          const stop = allStops.find((item) => item.id === id);
          if (!stop) return;
          const row = document.createElement('div');
          row.className = 'flex items-center gap-3 rounded-2xl border border-soil-700/15 bg-white p-4';
          const number = document.createElement('span');
          number.className = 'grid h-9 w-9 shrink-0 place-items-center rounded-full bg-leaf-100 text-sm font-black text-leaf-700';
          number.textContent = String(index + 1).padStart(2, '0');
          const text = document.createElement('div');
          text.className = 'min-w-0 flex-1';
          const name = document.createElement('p');
          name.className = 'font-bold';
          name.textContent = stop.name;
          const meta = document.createElement('p');
          meta.className = 'mt-1 text-xs text-soil-700';
          meta.textContent = stop.meta;
          text.append(name, meta);
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'rounded-full px-3 py-2 text-sm font-bold text-berry-700 hover:bg-berry-50';
          remove.textContent = 'Remove';
          remove.addEventListener('click', () => {
            writeSaved(readSaved().filter((savedId) => savedId !== id));
            render();
          });
          row.append(number, text, remove);
          itemsRoot.append(row);
        });
      };

      const openPanel = () => {
        if (!panel || !backdrop) return;
        panel.classList.remove('translate-x-full');
        panel.setAttribute('aria-hidden', 'false');
        backdrop.classList.remove('pointer-events-none', 'opacity-0');
        backdrop.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        panel.querySelector<HTMLElement>('[data-itinerary-close]')?.focus();
      };

      const closePanel = () => {
        if (!panel || !backdrop) return;
        panel.classList.add('translate-x-full');
        panel.setAttribute('aria-hidden', 'true');
        backdrop.classList.add('pointer-events-none', 'opacity-0');
        backdrop.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };

      document.querySelectorAll<HTMLButtonElement>('[data-itinerary-open]').forEach((button) => button.addEventListener('click', openPanel));
      document.querySelectorAll<HTMLButtonElement>('[data-itinerary-close]').forEach((button) => button.addEventListener('click', closePanel));
      backdrop?.addEventListener('click', closePanel);

      saveButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.id;
          if (!id) return;
          const ids = readSaved();
          writeSaved(ids.includes(id) ? ids.filter((savedId) => savedId !== id) : [...ids, id]);
          render();
        });
      });

      document.querySelector('#itinerary-clear')?.addEventListener('click', () => {
        localStorage.removeItem(STORAGE_KEY);
        render();
      });

      const galleryDialog = document.querySelector<HTMLDialogElement>('#gallery-dialog');
      const galleryImage = document.querySelector<HTMLImageElement>('#gallery-dialog-image');
      document.querySelectorAll<HTMLButtonElement>('[data-gallery-image]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!galleryDialog || !galleryImage) return;
          galleryImage.src = button.dataset.galleryImage || '';
          galleryImage.alt = button.dataset.galleryAlt || '';
          galleryDialog.showModal();
        });
      });
      document.querySelector<HTMLButtonElement>('#gallery-close')?.addEventListener('click', () => {
        galleryDialog?.close();
      });
      galleryDialog?.addEventListener('click', (event) => {
        if (event.target === galleryDialog) galleryDialog.close();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && panel?.getAttribute('aria-hidden') === 'false') closePanel();
      });

      render();
    </script>
  </body>
</html>
