---
import '../styles/global.css';
import Weather from '../components/Weather.astro';

const place = {
  fullName: 'Strawberry Farm - Home of Giant Strawberry Cake',
  name: 'Strawberry Farm - Home of Giant Strawberry Cake',
  shortName: 'Strawberry Farm',
  commonName: 'La Trinidad Strawberry Farm',
  city: 'La Trinidad',
  stateProvince: 'Benguet',
  country: 'Philippines',
  countryCode: 'PH',
  postalCode: '2601',
  address: 'Swamp Area, ID-58, Strawberry Valley Hotel, Strawberry Farm Rd, La Trinidad, 2601 Benguet, Philippines',
  latitude: 16.4580848,
  longitude: 120.5877882,
  rating: 4.3,
  ratingCount: 4100,
  opens: '06:00',
  closes: '18:00'
};

// Review data is shown on the page only (with source attribution) and is deliberately kept out of JSON-LD.
const reviewSyncStamp = '2026 年 9 月';
const reviewSourceNote = '同步自 Google 地图用户评价，同步时间 2026 年 9 月；版权归原作者与 Google 地图所有';
const govtTourismUrl = 'https://www.tourism.gov.ph/';
const nearbyLandmark1 = 'Baguio City';
const nearbyLandmark2 = 'Benguet State University';

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImageUrl = Astro.site ? new URL('/images/la-trinidad-strawberry-farm-01.webp', Astro.site).toString() : undefined;
const pageTitle = 'La Trinidad Strawberry Farm — Hours, Entrance Fee & Picking';
const mapsUrl = 'https://maps.app.goo.gl/Kof8tjQ4s5DdZfnL7';

const faqs = [
  {
    question: 'When is the best time to pick strawberries?',
    answer: 'Cool, dry-season mornings are the easiest time to visit. February to April is often a strong picking window, but harvest volume depends on weather, field rotation and the day’s crop. Arrive early and ask growers what is available before paying for a picking basket.'
  },
  {
    question: 'Is there an entrance fee?',
    answer: 'Walking around the wider farm and market area is commonly free. Small local, environmental or activity fees may be collected at some access points, and strawberry picking is charged separately by weight. Confirm the day’s arrangement onsite.'
  },
  {
    question: 'How much does strawberry picking cost?',
    answer: 'Picking is priced by weight and can change by grower, season and supply. Recent visitor reports commonly mention roughly ₱500–₱700 per kilogram as an indicative range, but it should not be treated as a fixed official rate.'
  },
  {
    question: 'What are the Strawberry Farm opening hours?',
    answer: 'Public listings commonly show the Strawberry Farm area opening daily from 6:00 AM to 6:00 PM. Individual stalls, cafés and picking plots keep their own hours, so the busiest, best-stocked window is usually early morning to late afternoon. Confirm peak-season hours locally before a very early or late visit.'
  },
  {
    question: 'Where is the Strawberry Farm located?',
    answer: 'It sits in Barangay Betag, La Trinidad, Benguet, along Strawberry Farm Road, about 20–30 minutes north of Baguio City centre when traffic is moving. Use the map pin (16.4580848, 120.5877882) and search for Strawberry Farm, Betag, La Trinidad rather than just “strawberry farm”.'
  },
  {
    question: 'How do I get to the Strawberry Farm from Baguio?',
    answer: 'The easiest options are a taxi or Grab straight to Strawberry Farm Road, or a La Trinidad-bound jeepney from the Magsaysay / Baguio Center Mall area, followed by a short walk into the farm area. Private cars follow the Baguio–La Trinidad–Bontoc Road and turn into Strawberry Farm Road.'
  },
  {
    question: 'Is this the official Strawberry Farm website?',
    answer: 'No. This is an independent visitor guide and is not affiliated with Benguet State University, the Municipality of La Trinidad or the farm operators. Official advisories and contest or festival announcements come from those bodies; use this page for practical trip planning, then confirm prices and hours onsite.'
  },
  {
    question: 'How long should I spend at the farm?',
    answer: 'Allow about 1.5–2.5 hours if you want to pick, browse the pasalubong stalls, snack and take photos. A quick market-and-photo stop can fit into roughly an hour.'
  },
  {
    question: 'Can I visit without picking strawberries?',
    answer: 'Yes. You can still walk the farm area, shop for fresh berries and local products, try strawberry snacks and enjoy the Cordillera valley scenery without joining a pick-your-own activity.'
  },
  {
    question: 'Is parking available?',
    answer: 'Parking is available around the farm area, but spaces can fill quickly on weekends, holidays and peak strawberry-season mornings. Paid parking may apply depending on the lot, so bring small cash and arrive early if driving.'
  }
];

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': canonicalUrl ? `${canonicalUrl}#attraction` : undefined,
  name: place.fullName,
  alternateName: [place.commonName, 'Strawberry Farm La Trinidad Benguet', 'Strawberry Farm Betag'],
  description: `Comprehensive visitor guide to ${place.commonName} in ${place.city}, ${place.stateProvince}, ${place.country}: opening hours, entrance fees, strawberry picking rates, how to get there from Baguio and nearby stops.`,
  hasMap: mapsUrl,
  sameAs: [mapsUrl, govtTourismUrl],
  priceRange: 'Free to enter; strawberry picking priced by weight',
  isAccessibleForFree: true,
  currenciesAccepted: 'PHP',
  paymentAccepted: 'Cash',
  touristType: ['Families', 'Day trippers', 'Food and market visitors'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Strawberry Farm Rd, Barangay Betag',
    addressLocality: place.city,
    addressRegion: place.stateProvince,
    postalCode: place.postalCode,
    addressCountry: place.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: place.latitude,
    longitude: place.longitude
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: place.opens,
      closes: place.closes
    }
  ],
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  ...(socialImageUrl ? { image: [socialImageUrl] } : {})
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};

const saveableStops = [
  { id: 'farm-picking', name: 'Pick strawberries', meta: 'Strawberry Farm · Betag' },
  { id: 'farm-market', name: 'Browse the pasalubong market', meta: 'Strawberry Farm · Betag' },
  { id: 'red-berry-cafe', name: 'Red Berry Cafe', meta: 'Near the Orchidarium' },
  { id: 'kabunian-cafe', name: 'Kabunian Cafe & Restaurant', meta: 'Strawberry Farm Road' },
  { id: 'mt-kalugong', name: 'Mt. Kalugong Cultural Village', meta: 'La Trinidad side trip' },
  { id: 'mt-yangbew', name: 'Mt. Yangbew', meta: 'Short ridge hike' },
  { id: 'mount-costa', name: 'Mount Costa', meta: 'Garden side trip' }
];
---
<!doctype html>
<html lang="en-PH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fffaf0" />
    <meta name="description" content="La Trinidad Strawberry Farm: opening hours, entrance fees, strawberry picking rates, parking and how to get there from Baguio. Plan your Benguet farm morning." />
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Strawberry Farm La Trinidad" />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content="Opening hours, entrance fees, strawberry picking rates and transport from Baguio — the practical guide to La Trinidad Strawberry Farm in Benguet." />
    <meta property="og:image" content={socialImageUrl ?? '/images/la-trinidad-strawberry-farm-01.webp'} />
    <meta property="og:image:alt" content="La Trinidad Strawberry Farm - strawberry fields in La Trinidad, Benguet, Philippines" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content="Opening hours, entrance fees, strawberry picking rates and transport from Baguio to La Trinidad Strawberry Farm." />
    <meta name="twitter:image" content={socialImageUrl ?? '/images/la-trinidad-strawberry-farm-01.webp'} />
    <meta name="twitter:image:alt" content="La Trinidad Strawberry Farm - strawberry fields in La Trinidad, Benguet, Philippines" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="La Trinidad Strawberry Farm" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(placeSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body class="paper-grain antialiased">
    <a href="#main" class="sr-only focus:not-sr-only fixed left-4 top-4 z-[100] rounded-full bg-ink px-4 py-2 text-sm font-bold text-white">Skip to content</a>

    <header class="relative z-50 border-b border-soil-700/15 bg-cream/92 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3 lg:px-8">
        <a href="#top" class="shrink-0" aria-label="Strawberry Farm visitor guide home">
          <img src="/logo.svg" width="270" height="64" alt="Strawberry Farm La Trinidad" class="h-14 w-auto" />
        </a>
        <nav aria-label="Primary" class="hidden items-center gap-1 text-sm font-semibold text-soil-700 lg:flex">
          <a href="#opening-hours" class="rounded-full px-3 py-2 hover:bg-leaf-100">Hours & fees</a>
          <a href="#getting-there" class="rounded-full px-3 py-2 hover:bg-leaf-100">Getting there</a>
          <a href="#weather" class="rounded-full px-3 py-2 hover:bg-leaf-100">Weather</a>
          <a href="#services" class="rounded-full px-3 py-2 hover:bg-leaf-100">Services</a>
          <a href="#seasons" class="rounded-full px-3 py-2 hover:bg-leaf-100">Seasons</a>
          <a href="#ecology" class="rounded-full px-3 py-2 hover:bg-leaf-100">Climate & ecology</a>
          <a href="#routes" class="rounded-full px-3 py-2 hover:bg-leaf-100">Routes</a>
          <a href="#science" class="rounded-full px-3 py-2 hover:bg-leaf-100">Science</a>
          <a href="#gallery" class="rounded-full px-3 py-2 hover:bg-leaf-100">Photos</a>
          <a href="#faq" class="rounded-full px-3 py-2 hover:bg-leaf-100">FAQ</a>
        </nav>
        <button type="button" data-itinerary-open class="flex items-center gap-2 rounded-full border border-leaf-700/20 bg-leaf-700 px-4 py-2.5 text-sm font-bold text-cream shadow-sm hover:bg-leaf-600" aria-controls="itinerary-panel">
          <span aria-hidden="true">✓</span>
          Day list <span data-itinerary-count class="rounded-full bg-cream/15 px-2 py-0.5 text-xs">0</span>
        </button>
      </div>
    </header>

    <main id="main">
      <section id="top" class="mountain-rule relative overflow-hidden bg-leaf-700 text-cream">
        <div class="absolute inset-0 opacity-35" aria-hidden="true" style="background:radial-gradient(circle at 18% 20%, #d7433b 0 2px, transparent 3px) 0 0/28px 28px"></div>
        <div class="relative mx-auto grid min-h-[760px] max-w-7xl items-center gap-10 px-5 pb-24 pt-12 lg:grid-cols-[0.88fr_1.12fr] lg:px-8 lg:pt-16">
          <div class="relative z-10 py-8 lg:py-16">
            <div class="mb-5 inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/8 px-4 py-2 text-sm font-semibold tracking-wide">
              <span class="berry-dot scale-75" aria-hidden="true"></span>
              La Trinidad Strawberry Farm · Benguet · Philippines
            </div>
            <p class="mb-3 text-xs font-black uppercase tracking-[0.28em] text-berry-200">La Trinidad, Benguet · Philippines</p>
            <h1 class="max-w-2xl font-display text-5xl font-bold leading-[0.98] tracking-[-0.035em] sm:text-6xl lg:text-7xl">
              La Trinidad Strawberry Farm
              <span class="mt-3 block text-3xl text-berry-200 sm:text-4xl lg:text-5xl">Visitor guide, hours &amp; strawberry picking</span>
            </h1>
            <p class="mt-7 max-w-xl text-lg leading-8 text-cream/80">
              Strawberry rows, cool Cordillera air, warm taho and a market full of red. Also known on Google Maps as the <strong class="font-bold text-cream">Strawberry Farm - Home of Giant Strawberry Cake</strong>, this independent field guide helps you make a simple La Trinidad farm morning feel unhurried.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#visit" class="rounded-full bg-berry-500 px-6 py-3.5 font-bold text-white shadow-lg shadow-black/15 hover:bg-berry-600">Plan your farm morning</a>
              <a href="#gallery" class="rounded-full border border-cream/25 bg-cream/8 px-6 py-3.5 font-bold text-cream hover:bg-cream/15">See real photos</a>
            </div>
            <ul class="mt-8 flex max-w-xl flex-wrap gap-2 text-sm font-semibold">
              <li class="rounded-full border border-white/20 bg-white/8 px-4 py-2">Open daily 6:00 AM–6:00 PM</li>
              <li class="rounded-full border border-white/20 bg-white/8 px-4 py-2">Farm area free to enter</li>
              <li class="rounded-full border border-white/20 bg-white/8 px-4 py-2">Picking ≈ ₱500–₱700/kg*</li>
              <li class="rounded-full border border-white/20 bg-white/8 px-4 py-2">20–30 min from Baguio</li>
            </ul>
            <p class="mt-3 max-w-xl text-xs leading-5 text-cream/55">*Visitor-reported indicative range for strawberry picking by weight. Confirm the day’s price with the grower before you start.</p>
            <dl class="mt-6 grid max-w-xl grid-cols-3 gap-3 border-t border-white/15 pt-6">
              <div><dt class="text-xs uppercase tracking-wider text-cream/55">Google rating</dt><dd class="mt-1 font-display text-2xl font-bold"><a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-berry-200">{place.rating} ★</a></dd><dd class="text-xs text-cream/55">{place.ratingCount.toLocaleString()} reviews</dd></div>
              <div><dt class="text-xs uppercase tracking-wider text-cream/55">Listed hours</dt><dd class="mt-1 font-display text-2xl font-bold">6–6</dd></div>
              <div><dt class="text-xs uppercase tracking-wider text-cream/55">Good stay</dt><dd class="mt-1 font-display text-2xl font-bold">1.5–2.5h</dd></div>
            </dl>
          </div>

          <div class="relative min-h-[490px] lg:min-h-[610px]">
            <figure class="absolute inset-x-8 top-3 overflow-hidden rounded-[2.6rem] border-[10px] border-cream shadow-2xl shadow-black/30 sm:inset-x-16 lg:inset-x-4 lg:left-16 lg:right-0">
              <img src="/images/la-trinidad-strawberry-farm-01.webp" width="1800" height="1350" alt="La Trinidad Strawberry Farm - strawberry fields and mountain slopes in La Trinidad, Philippines" class="h-[430px] w-full object-cover sm:h-[500px] lg:h-[560px]" fetchpriority="high" />
            </figure>
            <div class="absolute bottom-4 left-0 rotate-[-4deg] rounded-2xl bg-cream px-5 py-4 text-ink shadow-xl sm:left-8 lg:left-0">
              <p class="text-xs font-black uppercase tracking-[0.2em] text-berry-600">Field note</p>
              <p class="mt-1 font-display text-xl font-bold">Go early. Pick gently.</p>
              <p class="mt-1 max-w-[240px] text-sm leading-5 text-soil-700">Cooler air, softer light, and a better chance to find active picking rows.</p>
            </div>
            <div class="absolute right-0 top-0 rounded-full border-4 border-cream bg-berry-500 px-5 py-5 text-center text-sm font-black leading-4 text-white shadow-lg sm:right-6 lg:-right-5">
              HOME OF<br /><span class="font-display text-lg">GIANT</span><br />STRAWBERRY<br />CAKE
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24" aria-labelledby="story-heading">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.28em] text-berry-600">About this place</p>
            <h2 id="story-heading" class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl">About {place.commonName}</h2>
            <p class="mt-6 text-lg leading-8 text-soil-700">Welcome to <strong class="font-bold">{place.fullName}</strong> — widely recognized as the central <strong class="font-bold">{place.commonName}</strong>. Located in the heart of {place.city}, {place.stateProvince}, {place.country}, this working valley is a primary hub for travellers visiting the strawberry region around Baguio.</p>
            <nav aria-label="Location breadcrumb" class="mt-5 flex flex-wrap items-center gap-2 text-sm font-semibold text-soil-700">
              <span>{place.commonName}</span><span aria-hidden="true">→</span><span>{place.city}</span><span aria-hidden="true">→</span><span>{place.stateProvince}</span><span aria-hidden="true">→</span><span>{place.country}</span>
            </nav>
            <p class="mt-6 text-lg leading-8 text-soil-700">The Strawberry Farm sits in Betag, La Trinidad, where agriculture and tourism overlap. Visitors come for pick-your-own rows, but the farm’s character is just as much in the roadside stalls: berries, preserves, vegetables, woven goods and strawberry-flavoured pasalubong.</p>
            <h3 class="mt-6 font-display text-2xl font-bold tracking-tight">History &amp; significance of {place.commonName}</h3>
            <p class="mt-4 leading-7 text-soil-700">The valley’s story is agricultural long before it is tourist. La Trinidad sits on a cool upland plateau in Benguet, part of the Cordillera highlands farmed for generations by Ibaloi and Kankanaey communities — the broader reason Benguet is widely called the salad bowl of the Philippines.</p>
            <p class="mt-4 leading-7 text-soil-700">Strawberries took hold here because altitude and cool nights suit short-day, cool-climate varieties that struggle in the lowlands. Growers plant in raised beds and rotate plots through the year, and regional agricultural research — including the work associated with {nearbyLandmark2} — has supported how the crop is developed and taught in the valley.</p>
            <p class="mt-4 leading-7 text-soil-700">The “Home of Giant Strawberry Cake” label comes from the town’s Strawberry Festival tradition, when the harvest season is marked with an enormous strawberry cake. Treat it as living civic identity — a festival centrepiece and a landmark — rather than an exhibit that is standing on site every day.</p>
            <p class="mt-4 leading-7 text-soil-700">Names, origin stories and the legends attached to the valley and its neighbouring peaks belong to the people who keep them. Ask at a cultural village or a local museum rather than trusting roadside summaries; Mt. Kalugong Cultural Village and Benguet’s local museums are where those stories are properly told.</p>
          </div>
          <div class="grid grid-cols-2 gap-4 sm:gap-5">
            <figure class="overflow-hidden rounded-[2rem] shadow-[var(--shadow-soft)]"><img src="/images/la-trinidad-strawberry-farm-02.webp" width="1800" height="1200" alt="Visitors picking strawberries from farm rows" class="h-full min-h-[380px] w-full object-cover" loading="lazy" /></figure>
            <div class="grid gap-4 sm:gap-5">
              <figure class="overflow-hidden rounded-[2rem] shadow-[var(--shadow-soft)]"><img src="/images/la-trinidad-strawberry-farm-03.webp" width="1054" height="1400" alt="Giant strawberry landmark in La Trinidad" class="h-52 w-full object-cover sm:h-64" loading="lazy" /></figure>
              <div class="rounded-[2rem] bg-berry-500 p-6 text-white shadow-[var(--shadow-soft)] sm:p-8">
                <p class="font-display text-3xl font-bold">Strawberry & Rose Capital</p>
                <p class="mt-3 leading-6 text-white/80">La Trinidad’s farm identity makes this stop feel rooted in the valley, not staged around a single photo spot.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="reviews" class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24" aria-labelledby="reviews-heading">
        <div class="overflow-hidden rounded-[2.4rem] border border-soil-700/12 bg-white/55 shadow-[var(--shadow-soft)]">
          <div class="grid gap-8 p-8 sm:p-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
            <div>
              <p class="text-xs font-black uppercase tracking-[0.28em] text-berry-600">Visitor rating</p>
              <h2 id="reviews-heading" class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">What visitors rate on Google</h2>
              <div class="mt-6 flex items-end gap-4">
                <span class="font-display text-6xl font-bold text-ink">{place.rating} ★</span>
                <span class="pb-2 text-sm font-semibold text-soil-700">based on {place.ratingCount.toLocaleString()} Google reviews</span>
              </div>
              <p class="mt-4 max-w-xl text-sm leading-6 text-soil-700">{reviewSourceNote}</p>
            </div>
            <div class="flex flex-col items-start gap-4 lg:items-end">
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-berry-500 px-6 py-3.5 font-bold text-white shadow-lg shadow-black/15 hover:bg-berry-600">在谷歌地图查看全部评价 ↗</a>
              <p class="max-w-xs text-xs leading-5 text-soil-700 lg:text-right">评分与评价数同步自谷歌地图（Google Maps）用户评价 · {reviewSyncStamp} · <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-berry-600 underline underline-offset-2">点击查看谷歌地图全部评价↗</a></p>
            </div>
          </div>
        </div>
      </section>

      <section id="visit" class="border-y border-soil-700/10 bg-white/45 py-16 lg:py-24">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="max-w-3xl">
            <p class="text-xs font-black uppercase tracking-[0.28em] text-berry-600">Plan the visit</p>
            <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Opening hours, entrance fee & picking budget</h2>
            <p class="mt-4 text-lg leading-8 text-soil-700">Rates and crop availability change, so the most useful plan is to know what is stable—and what to confirm when you arrive.</p>
          </div>

          <div class="mt-10 grid gap-5 lg:grid-cols-12">
            <article id="opening-hours" class="field-card scroll-mt-24 rounded-[2rem] p-7 lg:col-span-5">
              <div class="flex items-start justify-between gap-5">
                <div><p class="text-xs font-black uppercase tracking-[0.2em] text-leaf-600">Opening & timing</p><h3 class="mt-2 font-display text-3xl font-bold">Start with the cool air.</h3></div>
                <span class="rounded-full bg-leaf-100 px-3 py-1 text-sm font-bold text-leaf-700">Daily listing</span>
              </div>
              <dl class="mt-7 divide-y divide-soil-700/10">
                <div class="flex justify-between gap-4 py-4"><dt class="text-soil-700">Listed opening hours</dt><dd class="font-bold">6:00 AM–6:00 PM</dd></div>
                <div class="flex justify-between gap-4 py-4"><dt class="text-soil-700">Best arrival</dt><dd class="text-right font-bold">Early morning</dd></div>
